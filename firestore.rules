rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // SVPUAT Hostel Management System
    // Auth strategy: Custom email/password (no Firebase Auth tokens)
    // Because Firebase Auth is NOT used, rules cannot check request.auth.
    // All reads and writes are permitted from the app itself.
    // ─────────────────────────────────────────────────────────────────────────

    // Users collection — warden registration, approval, login lookup
    match /users/{userId} {
      allow read, write: if true;
    }

    // Issues collection — hostel grievances
    match /issues/{issueId} {
      allow read, write: if true;
    }

    // Notifications collection — admin/warden notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Chat System collections
    match /chatRooms/{roomId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Audit logs (if enabled)
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Catch-all for any other collections used during development
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2030, 1, 1);
    }

  }
}
